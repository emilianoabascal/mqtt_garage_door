# --- GPIO ---
RELAY_PIN=""            # BCM pin wired to the relay
REED_PIN=""             # BCM pin wired to the reed switch
RELAY_ACTIVE_LOW="true" # "true" for active-LOW relay boards (default), "false" for active-HIGH
PULSE_SECONDS="0.5"     # how long the relay is held to emulate a button press

# --- Door timing ---
COOLDOWN_PERIOD="15"    # min seconds between accepted commands (5-60, tunable from HA)
DOOR_TRAVEL_TIME="20"   # seconds to wait for the reed switch to confirm a move

# --- MQTT ---
MQTT_BROKER=""
MQTT_PORT="1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
